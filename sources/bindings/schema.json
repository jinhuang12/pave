{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAVE Init harness binding",
  "type": "object",
  "required": [
    "version",
    "harness",
    "agent_output_kind",
    "skills",
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "harness": {"enum": ["claude", "codex"]},
    "agent_output_kind": {"enum": ["markdown", "toml"]},
