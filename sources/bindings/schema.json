        "pave-evolve": {
          "type": "object",
          "required": [
            "template",
            "output",
            "slots"
          ],
          "additionalProperties": false,
          "properties": {
            "template": {"type": "string"},
            "output": {"type": "string"},
            "slots": {
              "type": "object",
              "required": [
                "FRONTMATTER",
                "DISPATCH_CONTRACT"
              ],
              "additionalProperties": false,
              "properties": {
                "FRONTMATTER": {"type": "string"},
                "DISPATCH_CONTRACT": {"type": "string"}
              }
            }
          }
