                "PREFLIGHT",
                "SPAWN_RUNTIME",
                "SPAWN_ORDER",
                "SPAWN_ADDRESSES",
                "SPAWN_EXAMPLE",
                "MONITOR_DELIVERY",
                "PROVIDER_FAILURE",
                "SHUTDOWN",
                "DONE_RELEASE",
                "FIX_ROUTE",
                "NOTES_ROUTE",
                "LIST_AGENTS",
                "NEW_SESSION",
                "HOOK_CONTRACT",
                "RUNTIME_ANTIPATTERNS",
                "MODEL_REFERENCE",
                "PREFLIGHT_REFERENCE",
                "SKILL_EXAMPLES"
              ],
              "additionalProperties": false,
              "properties": {
                "FRONTMATTER": {
                  "type": "string"
                },
                "PEER_MESSAGES": {
                  "type": "string"
                },
                "RESOURCE_PATHS": {
                  "type": "string"
                },
                "LOG_COMMAND": {
                  "type": "string"
                },
                "ISOLATION": {
                  "type": "string"
                },
                "TEAM_MODELS": {
                  "type": "string"
                },
                "PREFLIGHT": {
                  "type": "string"
                },
                "SPAWN_RUNTIME": {
                  "type": "string"
                },
                "SPAWN_ORDER": {
                  "type": "string"
                },
                "SPAWN_ADDRESSES": {
                  "type": "string"
                },
                "SPAWN_EXAMPLE": {
                  "type": "string"
                },
                "MONITOR_DELIVERY": {
                  "type": "string"
                },
                "PROVIDER_FAILURE": {
                  "type": "string"
                },
                "SHUTDOWN": {
                  "type": "string"
                },
                "DONE_RELEASE": {
                  "type": "string"
                },
                "FIX_ROUTE": {
                  "type": "string"
                },
                "NOTES_ROUTE": {
                  "type": "string"
                },
                "LIST_AGENTS": {
                  "type": "string"
                },
                "NEW_SESSION": {
                  "type": "string"
                },
                "HOOK_CONTRACT": {
                  "type": "string"
                },
                "RUNTIME_ANTIPATTERNS": {
                  "type": "string"
                },
                "MODEL_REFERENCE": {
                  "type": "string"
                },
                "PREFLIGHT_REFERENCE": {
                  "type": "string"
                },
                "SKILL_EXAMPLES": {
                  "type": "string"
                }
              }
            },
            "references": {
              "type": "object",
              "required": [
                "protocol",
                "subtask",
                "model-seats"
              ],
              "additionalProperties": false,
              "properties": {
                "protocol": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "subtask": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "model-seats": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
