{
  "description": "AMMO campaign hooks for Codex CLI. Registered by .codex-plugin/plugin.json; every hook exits 0 with empty stdout outside an AMMO campaign.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/session_start.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/pre_compact.py\"",
            "timeout": 30,
            "statusMessage": "Saving AMMO compaction checkpoint"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/pre_tool_use_guard.py\"",
            "statusMessage": "Checking AMMO command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/post_tool_use_guard.py\"",
            "timeout": 7200,
            "statusMessage": "Reviewing AMMO command result"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/post_tool_use_guard.py\"",
            "statusMessage": "Registering AMMO subagent role"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/post_tool_use_guard.py\"",
            "statusMessage": "Checking AMMO subagent completion"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/codex/hooks/stop_gate_guard.py\"",
            "timeout": 7200,
            "statusMessage": "Checking AMMO gate completion"
          }
        ]
      }
    ]
  }
}
