{
  "description": "vLLM-Neuron parity effect guards and long-run alignment controls for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/pre_tool_use_router.py\" protected-branch",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/pre_tool_use_router.py\" compile-cache",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/pre_tool_use_router.py\" venv-opt",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/vllm-neuron-parity/hooks/state-staleness-reminder.sh\"",
            "timeout": 10,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/skills/vllm-neuron-parity/hooks/stop-guard.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
