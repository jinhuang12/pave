{
  "orchestrate": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/ag_hook_adapter.py session_start",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/ag_hook_adapter.py post_tool_speedup",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/ag_hook_adapter.py post_tool_maintainer",
            "timeout": 10
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/ag_hook_adapter.py post_invocation",
        "timeout": 10
      }
    ]
  }
}
